.env
.claude/settings.local.json
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.DS_Store


# ICOR Planner is its own git repository (and its data.json holds API keys)
.obsidian/plugins/icor-planner/

# Plugin and theme code lives in its own repos on the myICOR org
# (myicor-connect also keeps its OAuth token store out of git there)
.obsidian/plugins/myicor-connect/
.obsidian/themes/myICOR INKLINE/

# myICOR Connect token store (hard rule 9: secrets never reach git)
.obsidian/plugins/myicor-connect/data.json

# ICOR Focus is its own git repository (data.json holds the local opens log)
.obsidian/plugins/icor-focus/

# ICOR Diagrams is its own git repository
.obsidian/plugins/icor-diagrams/

# Live personal data syncs into these paths - never tracked, never shipped
02 Planner/*/
00 Daily Scratchpad/2026-*.md
00 Daily Scratchpad/2027-*.md

# ICOR Chat is its own git repository (data.json holds chat/session state)
.obsidian/plugins/icor-chat/
