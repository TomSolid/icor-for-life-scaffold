.env
.claude/settings.local.json
.obsidian/workspace-mobile.json
.DS_Store


# ICOR Planner is its own git repository (and its data.json holds API keys)
.obsidian/plugins/icor-for-life-planner/

# Plugin and theme code lives in its own repos on the myICOR org
# (Connect also keeps its OAuth token store out of git there)
.obsidian/plugins/icor-for-life-connect/
.obsidian/plugins/icor-for-life-interface/
.obsidian/themes/ICOR for Life - INKLINE/

# myICOR Connect token store (hard rule 9: secrets never reach git)
.obsidian/plugins/icor-for-life-connect/data.json

# ICOR Focus is its own git repository (data.json holds the local opens log)
.obsidian/plugins/icor-for-life-focus/


# Live personal data syncs into these paths - never tracked, never shipped
02 Planner/*/
00 Daily Scratchpad/2026-*.md
00 Daily Scratchpad/2027-*.md
# ... and the same notes in the YYYY/MM/ shape the scratchpad actually uses
# (GL-1004). The two flat lines above predate the nesting and match nothing;
# link-dates-to-daily-notes.py --fix creates daily notes, and a daily note is
# personal data that must never reach the zip.
00 Daily Scratchpad/[0-9][0-9][0-9][0-9]/

# ICOR AI Chat is its own git repository (data.json holds chat/session state)
.obsidian/plugins/icor-for-life-chat/

# ICOR Scaffold Check is its own git repository (data.json may hold a GitHub token)
.obsidian/plugins/icor-for-life-scaffold-check/

# ICOR Terminal is its own git repository (data.json holds shell profiles and their environment)
.obsidian/plugins/icor-for-life-terminal/

# ICOR Canvases is its own git repository (its main.js is untracked there too;
# the zip stages it from the plugin's latest GitHub release, like Chat and Terminal)
.obsidian/plugins/icor-for-life-canvases/
.obsidian/plugins/icor-for-life-scratchpad/

# The machine layer (GL-1008): what plugins and scripts write for each other,
# per device and regenerated, never tracked and never shipped. Only the four
# files that describe the scaffold version are kept.
.icor-for-life/*
!.icor-for-life/VERSION
!.icor-for-life/manifest.json
!.icor-for-life/CHANGELOG.md
!.icor-for-life/README.md

# Python bytecode, regenerated on every script run
__pycache__/
*.pyc
