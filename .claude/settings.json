{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/06 AI Team/AI Team Knowledge/Scripts/session-start.sh\"",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/06 AI Team/AI Team Knowledge/Scripts/write-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
