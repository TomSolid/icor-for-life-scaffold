# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-1002 fields. To change them: update GL-1002,
# then the registry in new-base.py, then re-stamp (GL-1006).
filters:
  and:
    - file.inFolder("04 Inner World/Notes")
    - file.ext == "md"
    - note.type == "note"
properties:
  file.name:
    displayName: Name
  note.note_type:
    displayName: Kind
  note.projects:
    displayName: Projects
  note.key_elements:
    displayName: Key Elements
  note.topics:
    displayName: Topics
  note.source_url:
    displayName: Source
  note.consumed:
    displayName: Consumed
views:
  - type: table
    name: Notes
    order:
      - file.name
      - note.note_type
      - note.projects
      - note.key_elements
      - note.topics
      - note.source_url
      - note.consumed
    sort:
      - property: file.name
        direction: ASC
