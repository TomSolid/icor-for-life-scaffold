# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-002 fields. To change them: update GL-002,
# then the registry in new-base.py, then re-stamp (GL-006).
filters:
  and:
    - file.inFolder("04 Inner World/Documents")
    - file.ext == "md"
    - note.type == "document"
properties:
  file.name:
    displayName: Name
  note.doc_type:
    displayName: Kind
  note.issued_on:
    displayName: Issued
  note.expiry_date:
    displayName: Expires
  note.amount:
    displayName: Amount
  note.currency:
    displayName: Currency
  note.source_file:
    displayName: File
views:
  - type: table
    name: Documents
    order:
      - file.name
      - note.doc_type
      - note.issued_on
      - note.expiry_date
      - note.amount
      - note.currency
      - note.source_file
    sort:
      - property: note.issued_on
        direction: DESC
  - type: cards
    name: Documents gallery
    image: note.preview_image
    order:
      - file.name
      - note.doc_type
      - note.issued_on
      - note.expiry_date
