# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-1002 fields. To change them: update GL-1002,
# then the registry in new-base.py, then re-stamp (GL-1006).
filters:
  and:
    - file.inFolder("04 Inner World/My Life/Topics")
    - file.ext == "md"
    - note.type == "topic"
properties:
  file.name:
    displayName: Name
  note.related_topics:
    displayName: Related
views:
  - type: table
    name: Topics
    order:
      - file.name
      - note.related_topics
    sort:
      - property: file.name
        direction: ASC
