# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-1002 fields. To change them: update GL-1002,
# then the registry in new-base.py, then re-stamp (GL-1006).
filters:
  and:
    - file.inFolder("04 Inner World/My Life/Key Elements")
    - file.ext == "md"
    - note.type == "key-element"
properties:
  file.name:
    displayName: Name
  note.goals:
    displayName: Goals
  note.people:
    displayName: People
views:
  - type: table
    name: Key Elements
    order:
      - file.name
      - note.goals
      - note.people
    sort:
      - property: file.name
        direction: ASC
