# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-1002 fields. To change them: update GL-1002,
# then the registry in new-base.py, then re-stamp (GL-1006).
filters:
  and:
    - file.inFolder("04 Inner World/My Life/Goals")
    - file.ext == "md"
    - note.type == "goal"
properties:
  file.name:
    displayName: Name
  note.status:
    displayName: Status
  note.target_date:
    displayName: Target
  note.key_elements:
    displayName: Key Elements
views:
  - type: table
    name: Goals
    order:
      - file.name
      - note.status
      - note.target_date
      - note.key_elements
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Active
    filters:
      and:
        - note.status == "not-achieved"
    order:
      - file.name
      - note.target_date
      - note.key_elements
    sort:
      - property: note.target_date
        direction: ASC
