# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-1002 fields. To change them: update GL-1002,
# then the registry in new-base.py, then re-stamp (GL-1006).
filters:
  and:
    - file.inFolder("04 Inner World/My Life/Habits")
    - file.ext == "md"
    - note.type == "habit"
properties:
  file.name:
    displayName: Name
  note.status:
    displayName: Status
  note.planner_habit:
    displayName: Planner
views:
  - type: table
    name: Habits
    order:
      - file.name
      - note.status
      - note.planner_habit
    sort:
      - property: file.name
        direction: ASC
