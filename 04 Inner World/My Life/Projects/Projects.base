# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-1002 fields. To change them: update GL-1002,
# then the registry in new-base.py, then re-stamp (GL-1006).
filters:
  and:
    - file.inFolder("04 Inner World/My Life/Projects")
    - file.ext == "md"
    - note.type == "project"
properties:
  file.name:
    displayName: Name
  note.focus_rank:
    displayName: Focus
  note.status:
    displayName: Status
  note.goal:
    displayName: Goal
  note.start_date:
    displayName: Started
  note.end_date:
    displayName: Ended
  note.key_elements:
    displayName: Key Elements
views:
  - type: table
    name: Projects
    order:
      - file.name
      - note.focus_rank
      - note.status
      - note.goal
      - note.start_date
      - note.end_date
      - note.key_elements
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Active
    filters:
      and:
        - note.status == "active"
    order:
      - file.name
      - note.focus_rank
      - note.goal
      - note.start_date
      - note.key_elements
    sort:
      - property: note.focus_rank
        direction: ASC
