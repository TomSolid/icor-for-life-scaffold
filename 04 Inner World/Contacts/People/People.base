# Generated by 06 AI Team/AI Team Knowledge/Scripts/new-base.py
# Columns are GL-002 fields. To change them: update GL-002,
# then the registry in new-base.py, then re-stamp (GL-006).
filters:
  and:
    - file.inFolder("04 Inner World/Contacts/People")
    - file.ext == "md"
    - note.type == "person"
properties:
  file.name:
    displayName: Name
  note.role:
    displayName: Role
  note.relation:
    displayName: Relation
  note.companies:
    displayName: Companies
  note.email:
    displayName: Email
  note.last_contact:
    displayName: Last contact
  note.next_action:
    displayName: Next action
views:
  - type: table
    name: People
    order:
      - file.name
      - note.role
      - note.relation
      - note.companies
      - note.email
      - note.last_contact
      - note.next_action
    sort:
      - property: file.name
        direction: ASC
