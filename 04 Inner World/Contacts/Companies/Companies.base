# Columns are GL-002 fields. To change them: update GL-002,
# then the registry in new-base.py, then re-stamp (GL-006).
filters:
  and:
    - file.inFolder("04 Inner World/Contacts/Companies")
    - file.ext == "md"
    - note.type == "company"
properties:
  file.name:
    displayName: Name
  note.industry:
    displayName: Industry
  note.people:
    displayName: People
  note.website:
    displayName: Website
views:
  - type: table
    name: Companies
    order:
      - file.name
      - note.industry
      - note.people
      - note.website
    sort:
      - property: file.name
        direction: ASC
